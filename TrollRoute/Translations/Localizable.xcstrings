          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici vous pouvez choisir la langue de l'application. Cette dernière se fermera automatiquement pour appliquer les modifications. Vous pourrez la relancer ensuite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här kan du välja vilket språk du vill att appen ska vara på. Appen kommer automatiskt att avslutas för att tillämpa ändringarna; starta den gärna igen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tại đây bác có thể chọn ngôn ngữ cho ứng dụng. Ứng dụng sẽ tự thoát để áp dụng thay đổi đó ; bạn có thể mở nó lại tuỳ thích."
